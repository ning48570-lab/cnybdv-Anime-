-- 1. ฟังก์ชันหาศัตรูใกล้ที่สุด
local function getClosestEnemy()
    local closestPlr = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    
    if myChar and myChar:FindFirstChild("HumanoidRootPart") then
        local myPos = myChar.HumanoidRootPart.Position
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local dist = (plr.Character.HumanoidRootPart.Position - myPos).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestPlr = plr
                    end
                end
            end
        end
    end
    return closestPlr
end

-- 2. ระบบวาร์ปสิงหลัง
RunService.RenderStepped:Connect(function()
    if isTpBehindOn then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local enemy = getClosestEnemy()
            if enemy and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
                local enemyHrp = enemy.Character.HumanoidRootPart
                myChar.HumanoidRootPart.CFrame = enemyHrp.CFrame * CFrame.new(0, 0, 2.5)
            end
        end
    end
end)

-- 3. ระบบ Auto Attack แบบแก้ไขใหม่ (ใช้อัลกอริทึม VirtualInputManager กดคลิกจริงใส่จอ)
task.spawn(function()
    while true do
        if autoAttack then
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    -- วิธีที่ 1: ตรวจหา Tool ในตัวแล้วสั่งกดใช้งาน
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        tool:Activate()
                    end
                    
                    -- วิธีที่ 2: จำลองการกดคลิกซ้ายระดับ Input System (ใช้ได้กับทุกเกมอนิเมะ)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait(0.02)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end
            end)
        end
        task.wait(0.1)
    end
end)

-- 4. ระบบ Auto Respawn
task.spawn(function()
    while true do
        if autoRespawn then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if not char or (hum and hum.Health <= 0) then
                task.wait(0.6)
                pcall(function()
                    LocalPlayer:LoadCharacter()
                end)
                pcall(function()
                    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                    if playerGui then
                        for _, gui in pairs(playerGui:GetDescendants()) do
                            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                                local btnText = string.lower(gui.Name .. " " .. (gui:IsA("TextButton") and gui.Text or ""))
                                if btnText:find("respawn") or btnText:find("play") or btnText:find("retry") or btnText:find("spawn") then
                                    GuiService.SelectedObject = gui
                                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                                end
                            end
                        end
                    end
                end)
            end
        end
        task.wait(1)
    end
end)
