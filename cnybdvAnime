-- -----------------------------------------------------------------
-- 🛡️ [ ระบบ Anti-Ban & Anti-Kick ]
-- -----------------------------------------------------------------
task.spawn(function()
    pcall(function()
        ScriptContext.Error:Connect(function() return nil end)
    end)

    if getrawmetatable and setreadonly then
        local rawmeta = getrawmetatable(game)
        local oldNamecall = rawmeta.__namecall
        setreadonly(rawmeta, false)

        rawmeta.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local strMethod = tostring(method)

            if (strMethod == "Kick" or strMethod == "kick") and (self == LocalPlayer or self == Players) then
                return nil
            end

            if strMethod == "FireServer" or strMethod == "InvokeServer" then
                local args = {...}
                if args[1] and type(args[1]) == "string" then
                    local argStr = string.lower(args[1])
                    if argStr:find("cheat") or argStr:find("exploit") or argStr:find("ban") or argStr:find("log") then
                        return nil
                    end
                end
            end

            return oldNamecall(self, ...)
        end)
        setreadonly(rawmeta, true)
    end
end)

